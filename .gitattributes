# Normalize line endings — this repo is edited from both Linux and Windows
# (/mnt/c mounts), which previously produced whole-file CRLF churn.
* text=auto

# Documentation and scripts: always LF
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf

# KiCad files are text S-expressions; keep them LF too
*.kicad_sch  text eol=lf
*.kicad_pcb  text eol=lf
*.kicad_pro  text eol=lf
*.kicad_sym  text eol=lf
*.kicad_mod  text eol=lf
*-lib-table  text eol=lf

# Binary
*.zip binary
*.bak binary

{
  "globs": ["**/*.md"],
  "ignores": [
    "Zynq-Carrier-Power/**",
    "thermometer-backups/**",
    "build/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD034": false,
    "MD060": false
  }
}
